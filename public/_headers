# Content-hashed build assets never change at the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Character frames are versioned with the site deployment.
/character/*
  Cache-Control: public, max-age=31536000, immutable

# Stable public media can be refreshed by the CDN without blocking visitors.
/case-files/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/easter-eggs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/erkan-ercan-social-card.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The resume may be replaced without changing its public URL.
/erkan-ercan-resume.pdf
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
